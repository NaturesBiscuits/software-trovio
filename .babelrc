{
  "presets": [
    ["@babel/preset-env", { 
      "targets": { "node": "current" },
      "modules": "commonjs"
    }],
    ["@babel/preset-react", { "runtime": "automatic" }],
    ["@babel/preset-typescript", { 
      "onlyRemoveTypeImports": true,
      "optimizeConstEnums": true
    }]
  ],
  "env": {
    "test": {
      "presets": [
        ["@babel/preset-env", { "targets": { "node": "current" } }],
        "@babel/preset-react",
        "@babel/preset-typescript"
      ]
    }
  }
}
